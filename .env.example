# Trav env — copy to .env.local and fill in. See docs/INTEGRATIONS.md §4.
# Never commit real values.

# --- The AI key (server only) ---
ANTHROPIC_API_KEY=

# --- Google Maps Platform ---
GOOGLE_MAPS_SERVER_KEY=            # server: Places, Geocoding, Distance Matrix, Directions
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=  # client: Maps JS/Static render (HTTP-referrer restricted)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # client-safe, RLS-enforced
SUPABASE_SERVICE_ROLE_KEY=         # server ONLY — bypasses RLS

# --- Meta WhatsApp Business Cloud API (server) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=               # verify inbound webhook signature
WHATSAPP_WEBHOOK_VERIFY_TOKEN=     # webhook subscription handshake

# --- Optional Stage-1 scrape backends (see INTEGRATIONS.md §5) ---
SCRAPER_API_KEY=
GUMLOOP_API_KEY=

# --- App ---
APP_URL=http://localhost:3000
